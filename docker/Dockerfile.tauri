# docker/Dockerfile.tauri — xless + what Tauri builds need (Rust, Node, LLVM binutils, shims; DMG tools for macOS).
ARG BASE

# libdmg-hfsplus (GPL-3): only its `dmg` and `hfsplus` executables are copied into the image and run as external
# tools; nothing of it is linked into xless. Built on the same base so the shared libraries match.
FROM ${BASE} AS libdmg
ARG LIBDMG_HFSPLUS_COMMIT
ARG LIBDMG_HFSPLUS_SHA256
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake make gcc libc6-dev zlib1g-dev libbz2-dev liblzma-dev \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    curl -fsSL -o /tmp/libdmg.tar.gz "https://github.com/mozilla/libdmg-hfsplus/archive/${LIBDMG_HFSPLUS_COMMIT}.tar.gz"; \
    echo "${LIBDMG_HFSPLUS_SHA256}  /tmp/libdmg.tar.gz" | sha256sum -c -; \
    mkdir -p /src/libdmg; tar -xzf /tmp/libdmg.tar.gz -C /src/libdmg --strip-components=1; \
    cmake -S /src/libdmg -B /build -DCMAKE_BUILD_TYPE=Release -DCMAKE_DISABLE_FIND_PACKAGE_OpenSSL=ON; \
    make -C /build -j"$(nproc)" dmg-bin hfsplus; \
    mkdir -p /out; install -m755 /build/dmg/dmg /build/hfs/hfsplus /out/; cp /src/libdmg/LICENSE /out/LICENSE

FROM ${BASE}
ARG TARGETARCH
ARG LIBDMG_HFSPLUS_COMMIT
ARG NODE_VERSION
ARG NODE_SHA256_ARM64
ARG NODE_SHA256_X64
ARG RUSTUP_VERSION
ARG RUSTUP_SHA256_AARCH64
ARG RUSTUP_SHA256_X86_64
ENV RUSTUP_HOME=/cache/rustup CARGO_HOME=/cache/cargo XLESS_SHIM_DIR=/opt/xless/shims XLESS_WORK_ROOT=/cache/work \
    PATH=/opt/xless/shims:/cache/cargo/bin:/opt/node/bin:$PATH COREPACK_HOME=/cache/corepack
RUN apt-get update \
 && apt-get install -y --no-install-recommends rsync git python3 python3-pil llvm xz-utils pkg-config \
      hfsprogs zlib1g libbz2-1.0 liblzma5 \
 && rm -rf /var/lib/apt/lists/*
# DMG tools: mkfs.hfsplus (hfsprogs, jammy universe) makes the empty HFS+ volume; dmg + hfsplus fill and convert it.
COPY --from=libdmg /out/dmg /out/hfsplus /usr/local/bin/
COPY --from=libdmg /out/LICENSE /usr/local/share/doc/libdmg-hfsplus/LICENSE
RUN echo "https://github.com/mozilla/libdmg-hfsplus/tree/${LIBDMG_HFSPLUS_COMMIT}" > /usr/local/share/doc/libdmg-hfsplus/SOURCE \
 && command -v mkfs.hfsplus && hfsplus 2>&1 | grep -q symlink && { dmg 2>&1 || true; } | grep -q build
RUN set -eux; \
    case "$TARGETARCH" in arm64) N=arm64; NS="$NODE_SHA256_ARM64"; R=aarch64-unknown-linux-gnu; RS="$RUSTUP_SHA256_AARCH64" ;; \
                          amd64) N=x64; NS="$NODE_SHA256_X64"; R=x86_64-unknown-linux-gnu; RS="$RUSTUP_SHA256_X86_64" ;; esac; \
    curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${N}.tar.xz"; \
    echo "${NS}  /tmp/node.tar.xz" | sha256sum -c -; mkdir -p /opt/node; tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; rm /tmp/node.tar.xz; \
    /opt/node/bin/corepack enable --install-directory /opt/node/bin; \
    curl -fsSL -o /usr/local/bin/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${R}/rustup-init"; \
    echo "${RS}  /usr/local/bin/rustup-init" | sha256sum -c -; chmod +x /usr/local/bin/rustup-init
COPY docker/shims/ /opt/xless/shims/
# Toolchains (from the project's rust-toolchain.toml) and the cargo registry live in cache volumes: /cache/rustup, /cache/cargo.
RUN chmod -R a+rx /opt/xless/shims && mkdir -p /cache && chmod 1777 /cache \
 && node --version && corepack --version && xcrun --sdk iphoneos --show-sdk-path && llvm-nm --version >/dev/null \
 && { command -v llvm-libtool-darwin || ln -s "$(ls /usr/bin/llvm-libtool-darwin-* | head -1)" /usr/local/bin/llvm-libtool-darwin; } \
 && test -x /usr/local/bin/llvm-libtool-darwin -o -x /usr/bin/llvm-libtool-darwin
WORKDIR /work
