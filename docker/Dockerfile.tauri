# docker/Dockerfile.tauri — xless + what Tauri iOS builds need (Rust, Node, LLVM binutils, shims).
ARG BASE
FROM ${BASE}
ARG TARGETARCH
ARG NODE_VERSION
ARG NODE_SHA256_ARM64
ARG NODE_SHA256_X64
ARG RUSTUP_VERSION
ARG RUSTUP_SHA256_AARCH64
ARG RUSTUP_SHA256_X86_64
ENV RUSTUP_HOME=/cache/rustup CARGO_HOME=/cache/cargo XLESS_SHIM_DIR=/opt/xless/shims XLESS_WORK_ROOT=/cache/work \
    PATH=/opt/xless/shims:/cache/cargo/bin:/opt/node/bin:$PATH COREPACK_HOME=/cache/corepack
RUN apt-get update \
 && apt-get install -y --no-install-recommends rsync git python3 python3-pil llvm xz-utils pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "$TARGETARCH" in arm64) N=arm64; NS="$NODE_SHA256_ARM64"; R=aarch64-unknown-linux-gnu; RS="$RUSTUP_SHA256_AARCH64" ;; \
                          amd64) N=x64; NS="$NODE_SHA256_X64"; R=x86_64-unknown-linux-gnu; RS="$RUSTUP_SHA256_X86_64" ;; esac; \
    curl -fsSL -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${N}.tar.xz"; \
    echo "${NS}  /tmp/node.tar.xz" | sha256sum -c -; mkdir -p /opt/node; tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1; rm /tmp/node.tar.xz; \
    /opt/node/bin/corepack enable --install-directory /opt/node/bin; \
    curl -fsSL -o /usr/local/bin/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${R}/rustup-init"; \
    echo "${RS}  /usr/local/bin/rustup-init" | sha256sum -c -; chmod +x /usr/local/bin/rustup-init
COPY docker/shims/ /opt/xless/shims/
# Toolchains (from the project's rust-toolchain.toml) and the cargo registry live in cache volumes: /cache/rustup, /cache/cargo.
RUN chmod -R a+rx /opt/xless/shims && mkdir -p /cache && chmod 1777 /cache \
 && node --version && corepack --version && xcrun --sdk iphoneos --show-sdk-path && llvm-nm --version >/dev/null \
 && { command -v llvm-libtool-darwin || ln -s "$(ls /usr/bin/llvm-libtool-darwin-* | head -1)" /usr/local/bin/llvm-libtool-darwin; } \
 && test -x /usr/local/bin/llvm-libtool-darwin -o -x /usr/bin/llvm-libtool-darwin
WORKDIR /work
